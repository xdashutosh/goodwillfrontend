# Frontend (Next.js) environment variables.
# In Vercel: Project → Settings → Environment Variables. These are inlined at
# BUILD time, so set them before deploying (Production + Preview).

# Base URL of the deployed backend API (NO trailing slash).
NEXT_PUBLIC_API_URL=https://goodwillprinters.onrender.com

# WhatsApp number for enquiry buttons (digits only, with country code).
NEXT_PUBLIC_WHATSAPP_NUMBER=919810000000

# Public URL of this site (used for metadata canonical URLs / OG tags).
NEXT_PUBLIC_SITE_URL=https://www.plan-a-day.com
